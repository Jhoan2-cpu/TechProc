# ======================================
# TechProc - Variables de Entorno
# ======================================

# API Configuration
# URL base de la API según DOCUMENTACION_BACKEND_API.md
# Desarrollo: http://localhost:8000/api/v1
# Producción: https://api.incadev.com/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Environment
# Valores: development | production | staging
VITE_ENV=development

# Feature Flags
# Usa datos mock en lugar de la API real
# true = modo desarrollo con mocks
# false = conectar a API real
VITE_USE_MOCK=false

# ======================================
# Instrucciones de Configuración
# ======================================
#
# 1. Copiar este archivo como .env en la raíz del proyecto:
#    cp .env.example .env
#
# 2. Ajustar las variables según tu entorno
#
# 3. NO commitear el archivo .env al repositorio
#    (ya está en .gitignore)
#
